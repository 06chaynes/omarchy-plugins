#!/bin/bash
# One ping through the WireGuard tunnel, called on a slower cadence than
# wireguard-details (see BarWidget.qml) since it blocks for up to ~1.5s.
# Prints JSON; the widget keeps its own rolling window of these samples to
# derive a packet-loss percentage over time.
iface="wg0"

if ! ip link show "$iface" &>/dev/null; then
  echo '{"ok":false}'
  exit 0
fi

target="${1:-}"
if [[ -z "$target" ]]; then
  # Auto-detect default gateway on wg0, or derive subnet gateway (.1), or fallback to 1.1.1.1
  gw=$(ip route show dev "$iface" 2>/dev/null | awk '/default/ {print $3}' | head -n 1)
  if [[ -n "$gw" ]]; then
    target="$gw"
  else
    ip_addr=$(ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    if [[ -n "$ip_addr" ]]; then
      target=$(echo "$ip_addr" | sed -E 's/\.[0-9]+$/\.1/')
    else
      target="1.1.1.1"
    fi
  fi
fi

output=$(ping -c 1 -W 1 -I "$iface" "$target" 2>/dev/null)
ms=$(grep -oP 'time=\K[0-9.]+' <<<"$output")

if [[ -n "$ms" ]]; then
  jq -nc --argjson ms "$ms" --arg target "$target" '{ok: true, ms: $ms, target: $target}'
else
  echo '{"ok":false}'
fi
