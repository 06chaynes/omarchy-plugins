#!/usr/bin/env python3
"""Drop a just-launched window out of fullscreen and size it.

RetroArch asks the compositor for fullscreen after its window is mapped, so
exec-time rules ([float], [size], [fullscreenstate]) are all overridden by the
time the request lands. This waits for the window belonging to one specific
pid, then corrects it. Matching on pid means it can never touch anything else.
"""

import json
import subprocess
import sys
import time


def clients():
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"],
                             capture_output=True, text=True, timeout=5).stdout
        return json.loads(out)
    except Exception:
        return []


def dispatch(expr):
    subprocess.run(["hyprctl", "dispatch", expr],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def main():
    pid, width, height = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
    # "tile" leaves the window in the layout so it can be arranged like any
    # other; "float" pins it to a fixed size. Either way the fullscreen
    # request is what has to be cleared.
    mode = sys.argv[4] if len(sys.argv) > 4 else "tile"
    deadline = time.monotonic() + 30
    address = None
    while time.monotonic() < deadline:
        for c in clients():
            if c.get("pid") == pid:
                address = c.get("address")
                break
        if address:
            break
        time.sleep(0.4)
    if not address:
        return 1

    target = 'window="address:%s"' % address
    # Re-assert for a few seconds: RetroArch can request fullscreen again once
    # the core finishes loading, after the first correction has been applied.
    until = time.monotonic() + 6
    while time.monotonic() < until:
        current = next((c for c in clients() if c.get("address") == address), None)
        if current is None:
            return 0
        if current.get("fullscreen"):
            dispatch("hl.dsp.window.fullscreen_state{internal=0,client=0,%s}" % target)
        if mode == "float":
            if not current.get("floating"):
                dispatch("hl.dsp.window.float{action=\"on\",%s}" % target)
            if list(current.get("size") or []) != [width, height]:
                dispatch('hl.dsp.window.resize{"exact %d %d",%s}' % (width, height, target))
        elif current.get("floating"):
            dispatch("hl.dsp.window.float{action=\"off\",%s}" % target)
        time.sleep(0.5)
    return 0


if __name__ == "__main__":
    sys.exit(main())
